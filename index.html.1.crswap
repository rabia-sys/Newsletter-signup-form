<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- displays site properly based on user's device -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="32x32" href="./assets/images/favicon-32x32.png">
  <link rel="stylesheet" href="style.css">
  <title>Frontend Mentor | Newsletter sign-up form with success message</title>

  <!-- Feel free to remove these styles or customise in your own stylesheet 👍 -->
  
</head>
<body>
<main class="container">
  <article class="card" id="signup-card">
  <section class="left-side">

  <h1>Stay updated!</h1>

  <p>Join 60,000+ product managers receiving monthly updates on:</p>
<ul>
 <li>
  <img src="./assets/images/icon-list.svg" alt="" aria-hidden="true">
  <span>Product discovery and building what matters</span>
</li>
  <li>
    <img src="./assets/images/icon-list.svg" alt="" aria-hidden="true">
   <span> Measuring to ensure updates are a success</span>
 </li>
 <li>
  <img src="./assets/images/icon-list.svg" alt="" aria-hidden="true">
  <span> And much more!</span>
  </li>
</ul>
<form id="newsletter-form" novalidate>
  <div class="input-header">
 <label for="email"> Email address</label>
 <span class="error-msg" id="error-msg" aria-live="polite"></span>
 </div>
 <input type="email" id="email" placeholder="email@company.com" >

  <button type="submit" >Subscribe to monthly newsletter</button>
  </form>
   </section>
   <section class="right-side">
    <picture>
      <source media="(min-width: 50em)" srcset="assets/images/illustration-sign-up-desktop.svg">
<img src="assets/images/illustration-sign-up-mobile.svg" alt="Newsletter signup illustration">
</picture>
 </section>
</article>
  <!-- Sign-up form end -->

  <!-- Success message start -->
<article class="card success-card hidden" id="success-card">
  <img src="assets/images/icon-success.svg" alt="" aria-hidden="true" class="success-icon">
  <h1>Thanks for subscribing!</h1>

 <p>A confirmation email has been sent to<strong id="user-email"> ash@loremcompany.com.</strong>
  Please open it and click the button inside to confirm your subscription.</p>
<button type="button" id="dis">Dismiss message</button>

  <!-- Success message end -->
  </article>
  <script src="script.js"></script>
</body>
</html>